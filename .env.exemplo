# Credenciais gratuitas da coleta. Copie para .env e preencha o que tiver.
# O .env não entra no git (ver .gitignore). Nenhuma é obrigatória: cada coletor
# que não achar a sua registra o motivo e a passada segue sem ele. Integrações
# pagas não entram aqui nem no ciclo padrão; veja a matriz em CREDENCIAIS.md.

# ── Biblioteca de Anúncios da Meta ────────────────────────────────────────────
# Histórico de anúncios políticos brasileiros dos últimos sete anos, com
# criativo, anunciante, datas, gasto, alcance e segmentação disponível.
# Exige verificação de identidade com documento (leva dias), app de
# desenvolvedor e token aceito pelo endpoint ads_archive.
#   https://www.facebook.com/ads/library/api
META_ADS_TOKEN=
# Versão atual validada pelo coletor; só altere se a Meta descontinuá-la.
META_GRAPH_API_VERSION=v26.0

# ── Telegram ──────────────────────────────────────────────────────────────────
# Histórico integral de canal público. Vetor central de circulação política no
# Brasil. Credencial gratuita e imediata em https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Media Cloud ───────────────────────────────────────────────────────────────
# Arquivo de 2 bilhões de matérias, 60 mil fontes, com suporte a português.
# Chave gratuita para pesquisa em https://www.mediacloud.org
MEDIACLOUD_API_KEY=

# ── YouTube Data API ──────────────────────────────────────────────────────────
# Opcional: o yt-dlp já cobre vídeo e metadados. A chave só é necessária para
# comentários em volume. 10.000 unidades/dia grátis.
YOUTUBE_API_KEY=

# ── TikTok Research API ───────────────────────────────────────────────────────
# Rota oficial para vídeos, contas, comentários, métricas e voice_to_text por
# palavra-chave/região. Exige aprovação institucional e parecer ético.
#   https://developers.tiktok.com/products/research-api/
TIKTOK_RESEARCH_CLIENT_KEY=
TIKTOK_RESEARCH_CLIENT_SECRET=

# ── Perfis públicos do Instagram ─────────────────────────────────────────────
# O embed público coleta posts conhecidos sem login. Para enumerar um perfil,
# forneça cookies de uma sessão própria ao gallery-dl. Prefira arquivo Netscape;
# a leitura direta do navegador pode pedir acesso ao Chaves do macOS.
INSTAGRAM_COOKIES_FILE=
# Alternativa: chrome, firefox, safari etc. Deixe vazia se usar o arquivo.
INSTAGRAM_COOKIES_FROM_BROWSER=

# ── Diário Oficial da União / INLABS ─────────────────────────────────────────
# Login gratuito no portal oficial. Libera os XMLs integrais das seis seções do
# DOU; o coletor retém apenas atos relacionados a eleição e propaganda.
#   https://inlabs.in.gov.br/
INLABS_EMAIL=
INLABS_PASSWORD=

# ── Espelho opcional dos ZIPs do TSE ─────────────────────────────────────────
# O CDN oficial é sempre tentado primeiro. Se esta rede continuar recebendo
# 403, aponte para um diretório HTTP que contenha os mesmos nomes de arquivo.
# Use somente um espelho sem cobrança; o projeto não contrata armazenamento.
MIND_TSE_MIRROR_BASE=

# ── Sal de anonimização ───────────────────────────────────────────────────────
# Usado no hash de autor. Opinião política é dado sensível pela LGPD, e o
# identificador nunca entra em claro no corpus. Troque antes de publicar
# qualquer coisa e não versione este valor.
MIND_SALT=troque-isto
# Diretórios opcionais. Por padrão os dados ficam em data/eleicoes2026 e o
# estado autenticado em .local-state/mind, ambos fora do Git.
MIND_DATA_DIR=
MIND_STATE_DIR=
